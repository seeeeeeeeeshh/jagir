# Path to the SQLite database file
DATABASE_PATH=data/job_tracker.db

# Directory Playwright uses as a persistent Chromium profile (log into LinkedIn here once)
BROWSER_PROFILE_DIR=data/browser_profile

# Show the browser window during sync (must stay true if you need to solve CAPTCHAs/logins manually)
BROWSER_HEADLESS=false

# Keep the browser open after a sync finishes instead of closing it
KEEP_BROWSER_OPEN=false

# How much raw scraped HTML to keep for debugging: errors_and_debug | every_sync | none
RAW_SNAPSHOT_MODE=errors_and_debug

# How many days to keep raw_snapshots rows before scripts/backup_db.py prunes them
RAW_SNAPSHOT_RETENTION_DAYS=14

# Safety caps for a single sync run — kept low deliberately so a sync reads
# as occasional manual browsing rather than a scraper at machine speed
MAX_ITEMS_PER_LIST=25
MAX_DETAIL_FETCHES_PER_RUN=8

# Randomized pause (seconds) between page actions during a sync
ACTION_DELAY_MIN_SECONDS=1.5
ACTION_DELAY_MAX_SECONDS=4.0

# Logging
LOG_LEVEL=INFO
LOG_DIR=data/logs

# Google Calendar (optional — see README's "Google Calendar" section for
# how to create these in Google Cloud Console). Leave blank to leave the
# Calendar page showing setup instructions instead of a connect button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
